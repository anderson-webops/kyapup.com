# Copy this file to back-end/.env for local development.
# Real environment files are ignored and must never be committed.
HOST=127.0.0.1
PORT=3006
TRUST_PROXY_HOPS=0
PHOTO_DATA_DIR=./data
ALLOWED_ORIGINS=http://localhost:3333,http://127.0.0.1:3333

# Generate with back-end/scripts/hash-password.mjs (see deploy/README.md).
# Paste the complete hash between single quotes. Empty disables local login.
ADMIN_PASSWORD_HASH=''
