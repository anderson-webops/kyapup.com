{
  "version": 1,
  "entrypoints": [
    "back-end/dist/server.js"
  ],
  "required": [
    "package.json",
    "package-lock.json",
    "back-end/package.json",
    "back-end/package-lock.json",
    "front-end/package.json",
    ".vitesse-release-prepared.json",
    "back-end/dist/server.js",
    "back-end/dist/runtime-version.js",
    "back-end/dist/app.js",
    "back-end/dist/server-config.js",
    "back-end/dist/boundedRateStore.js",
    "back-end/node_modules/cookie/compat.cjs",
    "back-end/node_modules/cookie/dist/index.js",
    "back-end/node_modules/encodeurl/compat.cjs",
    "back-end/node_modules/encodeurl/dist/index.js",
    "back-end/node_modules/raw-body/compat.cjs",
    "back-end/node_modules/raw-body/dist/index.js",
    "back-end/node_modules/type-is/compat.cjs",
    "back-end/node_modules/type-is/dist/index.js",
    "back-end/node_modules/iconv-lite/lib/index.js",
    "back-end/node_modules/mime-types/index.js",
    "front-end/.output/public/index.html",
    "front-end/.output/public/200.html",
    "front-end/.output/public/404.html",
    "front-end/.output/public/release.json"
  ],
  "runtime": {
    "os": "linux",
    "arch": "arm64",
    "node": "26.13.1",
    "npmBuildOnly": "12.2.3",
    "npmBuildProfile": "webops-locked-npm-v1",
    "npmBuildLockSha256": "90153ee57be72808b4cdfb24437f1e3882c038741bea651b2c0773b5df3c9c33",
    "npmBuildPayloadSha256": "4314422d2733a49dd773c05c6b8e01d430680506115d21193acc8de0788cd52c"
  },
  "deployment": {
    "schemaVersion": 1,
    "applicationId": "vitesse-nuxt-template",
    "artifactFormat": "vitesse-direct-runtime-v1",
    "requiredHostCapabilities": [
      "artifact-only-promotion-v1",
      "verified-source-and-payload-v1",
      "protected-immutable-staging-v1",
      "retained-artifact-rollback-v1",
      "version-aware-readiness-v1",
      "dual-stack-release-identity-v1"
    ],
    "probes": {
      "apiHealth": { "path": "/api/health", "methods": ["GET", "HEAD"], "success": 200 },
      "apiReadiness": { "path": "/api/readyz", "methods": ["GET", "HEAD"], "success": 200, "failure": 503 },
      "staticIdentity": { "path": "/release.json", "field": "commitSha", "addressFamilies": ["ipv4", "ipv6"] }
    },
    "migrations": "none",
    "rollback": "verify-retained-artifact-and-identity",
    "hostControlled": ["service-user", "listener", "reverse-proxy", "protected-environment"]
  },
  "modulesOutsideDist": [],
  "generatedClients": [],
  "nativeBindings": [],
  "staticAssets": [
    "front-end/.output/public"
  ],
  "dependencyRoots": [
    "back-end"
  ],
  "writableState": [
    {
      "name": "logs",
      "location": "existing service journal",
      "rollback": "preserve journal; no application filesystem state or migrations"
    }
  ],
  "privateConfiguration": "Protected host environment stays external. The template has no database, provider credentials, queue or durable local state. Downstreams must declare any additions.",
  "topology": "Static Nuxt output with independent compiled Express API; preserve installed paths, users, ports, IPv4/IPv6 and edge policy. This optional direct-release artifact does not replace the separate Netlify function adapter."
}
